{
  "name": "weave-local",
  "interface": {
    "displayName": "Weave Local Plugins"
  },
  "metadata": {
    "generatedBy": "@weave/adapter-codex",
    "ownership": "weave-managed"
  },
  "plugins": [
    {
      "name": "weave-codex",
      "source": {
        "source": "local",
        "path": "./plugins/weave-codex"
      },
      "policy": {
        "installation": "INSTALLED_BY_DEFAULT",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
