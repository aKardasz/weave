#!/usr/bin/env sh
set -eu

echo "▶ codesight..."
bunx --bun codesight
git add .codesight/

echo "▶ lint-staged..."
bunx --bun --no-install lint-staged

echo "▶ typecheck..."
bun run typecheck

echo "▶ validate-config..."
bun run validate-config

echo "▶ test..."
bun test --recursive

echo "✔ all checks passed"
